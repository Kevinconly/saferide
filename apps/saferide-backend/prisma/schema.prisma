// Prisma schema for SafeRide Kigali - MongoDB (local dev) + production-ready
// Prisma Migrate is supported on MongoDB. Run:
//   npx prisma db push          # local quick sync
//   npx prisma migrate deploy   # production migrations

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  PASSENGER
  DRIVER
  ADMIN
  SUPER_ADMIN
}

enum DriverStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum RideStatus {
  REQUESTED
  PENDING_ACCEPTANCE
  ACCEPTED
  DRIVER_EN_ROUTE
  ARRIVED
  PASSENGER_ON_BOARD
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DRIVER_NO_SHOW
  PASSENGER_NO_SHOW
  DISPUTE
  FAILED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SETTLED
  FAILED
  REFUNDED
}

enum DocumentType {
  ID_CARD
  DRIVER_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
}

enum AuditAction {
  USER_UPDATE
  DRIVER_APPROVAL
  RIDE_STATE_CHANGE
  PAYMENT_ADJUSTMENT
  DISPUTE_RESOLUTION
  AUTH_EVENT
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  phone             String   @unique
  username          String?  @unique
  email             String?  @unique
  name              String?
  role              UserRole @default(PASSENGER)
  status            String   @default("ACTIVE")
  statusMessage     String?
  preferredLanguage String?
  passwordHash      String?
  tokenVersion      Int      @default(0)
  isVerified        Boolean  @default(false)
  isPhoneVerified   Boolean  @default(false)
  isEmailVerified   Boolean  @default(false)
  emailVerifiedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  driver          Driver?
  refreshTokens   RefreshToken[]
  devices         Device[]
  subscriptions   NotificationSubscription[]
  notifications   Notification[]
  rides           Ride[]   @relation("PassengerRides")
  payments        Payment[]
  disputes        Dispute[] @relation("DisputePassenger")
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")
  auditLogs       AuditLog[]
}

model Driver {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  vehicleMake       String?
  vehicleModel      String?
  plateNumber       String?
  licenseNumber     String?   @unique
  vehicleNumber     String?   @unique
  vehicleYear       Int?
  insuranceProvider String?
  insuranceExpiry   DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  suspensionReason  String?
  rating            Float?    @default(5.0)
  status            DriverStatus @default(PENDING)
  isVerified        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  rides        Ride[]   @relation("DriverRides")
  payouts      DriverPayout[]
  documents    DriverDocument[]
  disputes     Dispute[] @relation("DisputeDriver")
  ratings      Rating[] @relation("RatingsForDriver")
}

model Ride {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  passengerId  String    @db.ObjectId
  passenger    User      @relation(fields: [passengerId], references: [id], name: "PassengerRides")
  driverId     String?   @db.ObjectId
  driver       Driver?   @relation(fields: [driverId], references: [id], name: "DriverRides")
  pickupLat    Float
  pickupLng    Float
  pickupLabel  String?
  dropoffLat   Float
  dropoffLng   Float
  dropoffLabel String?
  distanceKm   Float?
  fareCents    Int
  currency     String    @default("RWF")
  state        RideStatus @default(REQUESTED)
  offerId      String?
  cancelledBy  String?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  completedAt  DateTime?
  events       RideEvent[]
  rideLocations RideLocation[] @relation("RideTakenLocations")
  payment      Payment?
  dispute      Dispute?
  rating       Rating?

  @@index([passengerId])
  @@index([driverId])
  @@index([state])
}

model RideEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId    String   @db.ObjectId
  ride      Ride     @relation(fields: [rideId], references: [id])
  actor     String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([rideId])
}

model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  rideId            String?       @unique @db.ObjectId
  ride              Ride?         @relation(fields: [rideId], references: [id])
  userId            String?       @db.ObjectId
  user              User?         @relation(fields: [userId], references: [id])
  amountCents       Int
  currency          String        @default("RWF")
  provider          String
  providerReference String?       @unique
  idempotencyKey    String?
  status            PaymentStatus @default(PENDING)
  metadata          Json?
  refundReason      String?
  createdAt         DateTime      @default(now())
  processedAt       DateTime?

  @@index([userId])
  @@index([status])
}

model RefreshToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  deviceId   String?
  revoked    Boolean  @default(false)
  issuedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  @@index([userId])
}

model Device {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id])
  platform   String
  tokenHash  String
  isActive   Boolean  @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
}

model NotificationSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  payload   Json?
  priority  String   @default("MEDIUM")
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Outbox {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  deliveredAt   DateTime?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, attempts])
}

model DriverPayout {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId    String   @db.ObjectId
  driver      Driver   @relation(fields: [driverId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  grossAmount Int
  commission  Int
  netAmount   Int
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([driverId])
}

model DriverDocument {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  driverId        String       @db.ObjectId
  driver          Driver       @relation(fields: [driverId], references: [id])
  type            DocumentType
  url             String
  storageKey      String?      @unique
  fileName        String?
  contentType     String?
  fileSize        Int?
  verified        Boolean      @default(false)
  uploadedAt      DateTime     @default(now())
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  deletedAt       DateTime?
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())

  @@index([driverId])
}

model Dispute {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId       String   @unique @db.ObjectId
  ride         Ride     @relation(fields: [rideId], references: [id])
  passengerId  String   @db.ObjectId
  passenger    User     @relation(fields: [passengerId], references: [id], name: "DisputePassenger")
  driverId     String?  @db.ObjectId
  driver       Driver?  @relation(fields: [driverId], references: [id], name: "DisputeDriver")
  reason       String
  status       String   @default("OPEN")
  resolution   String?
  resolvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId    String   @unique @db.ObjectId
  ride      Ride     @relation(fields: [rideId], references: [id])
  raterId   String   @db.ObjectId
  rater     User     @relation(fields: [raterId], references: [id], name: "RatingsGiven")
  rateeId   String   @db.ObjectId
  ratee     User     @relation(fields: [rateeId], references: [id], name: "RatingsReceived")
  driverId  String?  @db.ObjectId
  driver    Driver?  @relation(fields: [driverId], references: [id], name: "RatingsForDriver")
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

model RideLocation {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId     String   @db.ObjectId
  ride       Ride     @relation("RideTakenLocations", fields: [rideId], references: [id])
  latitude   Float
  longitude  Float
  accuracy   Int?
  recordedAt DateTime @default(now())

  @@index([rideId])
}

model AuditLog {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?     @db.ObjectId
  actor      User?       @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     AuditAction
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
