// Prisma schema for SafeRide Kigali - MVP core entities
// Use `DATABASE_URL` env var to connect

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
  SUPER_ADMIN
}

enum RideState {
  REQUESTED
  MATCHING
  OFFERED
  RESERVED
  EN_ROUTE_TO_PICKUP
  ARRIVED_AT_PICKUP
  PICKED_UP
  EN_ROUTE_TO_DROPOFF
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String   @id @default(uuid())
  phone              String   @unique
  email              String?  @unique
  name               String?
  role               Role     @default(PASSENGER)
  status             UserStatus @default(ACTIVE)
  passwordHash       String?
  isVerified         Boolean  @default(false)
  emailVerifiedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?
  driver             Driver?
  refreshTokens      RefreshToken[]
  devices            Device[]
  subscriptions      NotificationSubscription[]
  notifications      Notification[]
  rides              Ride[]   @relation("PassengerRides")
  payments           Payment[]
  disputes           Dispute[] @relation("DisputePassenger")
  ratingsGiven       Rating[] @relation("RatingsGiven")
  ratingsReceived    Rating[] @relation("RatingsReceived")
  auditLogs          AuditLog[]
}

model Driver {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  vehicleMake  String?
  vehicleModel String?
  plateNumber  String?
  rating       Float?   @default(5.0)
  status       String   @default("PENDING")
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  rides        Ride[]   @relation("DriverRides")
  payouts      DriverPayout[]
  documents    DriverDocument[]
  disputes     Dispute[] @relation("DisputeDriver")
  ratings      Rating[] @relation("RatingsForDriver")
}

model Ride {
  id            String    @id @default(uuid())
  passengerId   String
  passenger     User      @relation(fields: [passengerId], references: [id], name: "PassengerRides")
  driverId      String?
  driver        Driver?   @relation(fields: [driverId], references: [id], name: "DriverRides")
  pickupLat     Float
  pickupLng     Float
  pickupLabel   String?
  dropoffLat    Float
  dropoffLng    Float
  dropoffLabel  String?
  distanceKm    Float?
  fareCents     Int
  currency      String    @default("RWF")
  state         RideState @default(REQUESTED)
  offerId       String?
  cancelledBy   String?
  cancelReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledAt   DateTime?
  completedAt   DateTime?
  events        RideEvent[]
  payment       Payment?
  dispute       Dispute?
  rating        Rating?
}

model RideEvent {
  id        String   @id @default(uuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id])
  actor     String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())
}

model Payment {
  id                 String        @id @default(uuid())
  rideId             String?       @unique
  ride               Ride?         @relation(fields: [rideId], references: [id])
  userId             String?
  user               User?         @relation(fields: [userId], references: [id])
  amountCents        Int
  currency           String        @default("RWF")
  provider           String
  providerReference  String?       @unique
  idempotencyKey     String?
  status             PaymentStatus @default(PENDING)
  metadata           Json?
  refundReason       String?
  createdAt          DateTime      @default(now())
  processedAt        DateTime?
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model Device {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  platform    String
  tokenHash   String
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
}

model NotificationSubscription {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  payload   Json?
  priority  String   @default("MEDIUM")
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Outbox {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  deliveredAt   DateTime?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, attempts])
}

model DriverPayout {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  grossAmount   Int
  commission    Int
  netAmount     Int
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model DriverDocument {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  type      String
  url       String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Dispute {
  id            String   @id @default(uuid())
  rideId        String   @unique
  ride          Ride     @relation(fields: [rideId], references: [id])
  passengerId   String
  passenger     User     @relation(fields: [passengerId], references: [id], name: "DisputePassenger")
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id], name: "DisputeDriver")
  reason        String
  status        String   @default("OPEN")
  resolution    String?
  resolvedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Rating {
  id        String   @id @default(uuid())
  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])
  raterId   String
  rater     User     @relation(fields: [raterId], references: [id], name: "RatingsGiven")
  rateeId   String
  ratee     User     @relation(fields: [rateeId], references: [id], name: "RatingsReceived")
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id], name: "RatingsForDriver")
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
