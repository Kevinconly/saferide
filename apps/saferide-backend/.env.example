PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saferide_dev
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:3001

# JWT / Auth
# Use file paths to RSA keys or environment values (recommended: file paths or secrets manager)
JWT_ACCESS_TOKEN_PRIVATE_KEY_PATH=path/to/jwt_access_private.key
JWT_ACCESS_TOKEN_PUBLIC_KEY_PATH=path/to/jwt_access_public.key
JWT_REFRESH_TOKEN_SECRET=<random-refresh-secret>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_ROTATE=true

# Google Maps
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Firebase (FCM) - path to service account JSON on server or use secrets manager
FCM_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# MTN MoMo (sandbox / production credentials)
MTN_MOMO_CLIENT_ID=<mtn-client-id>
MTN_MOMO_CLIENT_SECRET=<mtn-client-secret>
MTN_MOMO_SUBSCRIPTION_KEY=<mtn-subscription-key>
MTN_MOMO_CALLBACK_SECRET=<mtn-webhook-secret>

# Airtel Money (sandbox / production credentials)
AIRTEL_CLIENT_ID=<airtel-client-id>
AIRTEL_CLIENT_SECRET=<airtel-client-secret>
AIRTEL_CALLBACK_SECRET=<airtel-webhook-secret>

# S3 / Object Storage (for uploaded documents)
S3_ENDPOINT=<s3-endpoint-or-empty-for-aws>
S3_BUCKET=<bucket-name>
AWS_REGION=<aws-region>
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

# Sentry
SENTRY_DSN=<your-sentry-dsn-or-empty>

# Misc / Feature flags
MAINTENANCE_MODE=false

# NOTE:
# - Never commit real secrets to source control. Use environment-specific secret stores (AWS Secrets Manager, GCP Secret Manager, Vault) in production.
# - For local development, keep a copy of .env.local with developer-only credentials and exclude it from git.
