# Saferide Web app .env.example
# Copy to .env and fill values per environment.
# These NEXT_PUBLIC_* variables are inlined into the client bundle at build time.

# Backend API base URL (must include the /api/v1 prefix). Set the production
# backend URL (e.g. https://your-api.up.railway.app/api/v1) in your host's
# build-time env for production builds.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# WebSocket server URL
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Google Maps (bring your own key — a real key committed here would be leaked)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Payment sandbox mode (true = use sandbox providers for local testing)
NEXT_PUBLIC_SANDBOX=true
