# Saferide Web app .env.example
# Copy to .env and fill values per environment.
# These NEXT_PUBLIC_* variables are inlined into the client bundle at build time.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket server URL
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Google Maps (demo key provided)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAeJrrphchoph6i9nMK0ERNDrU3P-EWaUM

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Payment sandbox mode (true = use sandbox providers for local testing)
NEXT_PUBLIC_SANDBOX=true
