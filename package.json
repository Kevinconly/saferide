{
  "name": "saferide-kigali",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "start": "npm run start:web",
    "build": "npm run build:web",
    "lint": "npm run lint:web",
    "dev:backend": "npm run start:dev --workspace=saferide-backend",
    "dev:web": "npm run dev --workspace=saferide-web",
    "dev:mobile": "npm run start --workspace=saferide-mobile",
    "dev:driver-mobile": "npm run start --workspace=saferide-driver-mobile",
    "test": "npm --workspace=saferide-backend run test:unit",
    "build:backend": "npm --workspace=saferide-backend run build",
    "build:web": "npm --workspace=saferide-web run build",
    "start:web": "npm run start --workspace=saferide-web",
    "lint:web": "npm run lint --workspace=saferide-web",
    "typecheck": "npm --workspace=saferide-backend run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
