# Saferide Monorepo top-level .env.example
# Copy to .env at repo root or per-service .env and fill values per environment.

# GENERAL
NODE_ENV=development
LOG_LEVEL=info

# Backend service
API_PORT=3000
API_ORIGIN=saferideapi-production.up.railway.app
# Database (Postgres) - canonical DB used by backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saferide_dev

# Redis
REDIS_URL=redis://localhost:6379

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaSyAeJrrphchoph6i9nMK0ERNDrU3P-EWaUM
# Expose Google Maps to the web app as a public key (demo key provided)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAeJrrphchoph6i9nMK0ERNDrU3P-EWaUM

# Firebase (FCM) - path to service account JSON or secrets manager reference
FCM_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# Payment providers (MTN MoMo / Airtel) - fill sandbox keys for development
MTN_MOMO_CLIENT_ID=<mtn-client-id>
MTN_MOMO_CLIENT_SECRET=<mtn-client-secret>
MTN_MOMO_SUBSCRIPTION_KEY=<mtn-subscription-key>
MTN_MOMO_CALLBACK_SECRET=<mtn-webhook-secret>

AIRTEL_CLIENT_ID=<airtel-client-id>
AIRTEL_CLIENT_SECRET=<airtel-client-secret>
AIRTEL_CALLBACK_SECRET=<airtel-webhook-secret>

# Object storage (S3)
S3_ENDPOINT=<s3-endpoint-or-empty-for-aws>
S3_BUCKET=<bucket-name>
AWS_REGION=<aws-region>
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

# Sentry
SENTRY_DSN=<your-sentry-dsn-or-empty>

# JWT keys / Auth
JWT_ACCESS_TOKEN_PRIVATE_KEY_PATH=/secrets/jwt_access_private.key
JWT_ACCESS_TOKEN_PUBLIC_KEY_PATH=/secrets/jwt_access_public.key
JWT_REFRESH_TOKEN_SECRET=<random-refresh-secret>

# Feature flags and tiers
# TIERS can be used to gate behavior in code. Fill with comma-separated tier names if used.
TIERS=free,basic,premium

# Operator / Admin
ADMIN_EMAIL=<admin@example.com>

# NOTES:
# - Never commit real secrets. Use a secrets manager for production credentials and set values in deployment environment.
# - For local development, use a .env.local file excluded from git.
